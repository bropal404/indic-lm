            "source": [
                "## 2. Tokenization glue used by Phase 2\n",
                "\n",
                "`customBPE.tokenize()` returns subword pieces but does not preserve whitespace. Phase 2 therefore used the `▁` boundary token around each pre-tokenized word. The same encoding/decoding convention is reused here."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 4,
            "id": "ba4123b0",
            "metadata": {
                "execution": {
                    "iopub.execute_input": "2026-09-16T09:14:10.364931Z",
                    "iopub.status.busy": "2026-09-16T09:14:10.364357Z",
                    "iopub.status.idle": "2026-09-16T09:14:10.372943Z",
                    "shell.execute_reply": "2026-09-16T09:14:10.372026Z"
                },
                "papermill": {
                    "duration": 0.016089,
                    "end_time": "2026-09-16T09:14:10.374514+00:00",
                    "exception": false,
                    "start_time": "2026-09-16T09:14:10.358425+00:00",
                    "status": "completed"
                },
                "tags": []
            },
            "outputs": [
                {
                    "name": "stdout",
                    "output_type": "stream",
                    "text": [
                        "Sample: भारत एक महान देश है।\n",
                        "Encoded: [14222, 161, 14222, 25, 14222, 10091, 14222, 2689, 14222, 7938, 11]\n",
                        "Decoded: भारत एक महान देश है।\n"
                    ]
                }
            ],
            "source": [
                "def encode_text(text, add_bos=False, add_eos=False):\n",
                "    ids = []\n",
                "    if add_bos and BOS_ID is not None:\n",
                "        ids.append(BOS_ID)\n",
                "\n",
                "    words = tokenizer.pre_tokenizer.tokenize(text)\n",
                "    for word in words:\n",
                "        ids.append(BOW_ID)\n",
                "\n",
                "        pieces = tokenizer._token_cache.get(word)\n",
                "        if pieces is None:\n",
                "            pieces = tokenizer.tokenize(word)\n",
                "\n",
                "        for piece in pieces:\n",
                "            ids.append(VOCAB.get(piece, UNK_ID))\n",
                "\n",
                "    if add_eos and EOS_ID is not None:\n",
                "        ids.append(EOS_ID)\n",
                "\n",
                "    return ids\n",
                "\n",
                "def decode_ids(ids):\n",
                "    words = []\n",
                "    current = \"\"\n",
                "\n",
                "    for raw_id in ids:\n",
                "        token = ID_TO_TOKEN.get(int(raw_id), \"\")\n",
                "\n",
                "        if token == \"▁\":\n",
                "            if current:\n",
                "                words.append(current)\n",
                "            current = \"\"\n",
                "        elif token in {\"<pad>\", \"<bos>\", \"<eos>\"}:\n",
                "            continue\n",
                "        else:\n",
                "            current += token\n",
                "\n",
                "    if current:\n",
                "        words.append(current)\n",
                "\n",
                "    return \" \".join(words)\n",
                "\n",
                "sample = \"भारत एक महान देश है।\"\n",
                "encoded = encode_text(sample)\n",
                "print(\"Sample:\", sample)\n",
                "print(\"Encoded:\", encoded[:30])\n",
                "print(\"Decoded:\", decode_ids(encoded))"
            ]
        },
